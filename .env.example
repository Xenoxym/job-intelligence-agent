# Compose supplies its own PostgreSQL URL. This password is local-only; replace for any shared environment.
POSTGRES_PASSWORD=local-development-only
APP_ENV=development
API_TOKEN=
SEED_DEMO=true
ALLOWED_HOSTS=localhost,127.0.0.1
# For native fallback only (not read automatically; export or use uvicorn --env-file .env)
# DATABASE_URL=sqlite:///./jobs.db
